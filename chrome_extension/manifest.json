{
    "manifest_version": 3,
    "name": "Servio Dashboard",
    "version": "1.0",
    "description": "Quick access to the RestoFy Restaurant Management System",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}